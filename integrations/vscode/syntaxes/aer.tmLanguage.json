{
  "scopeName": "source.aer",
  "name": "AER",
  "patterns": [
    { "include": "#comment" },
    { "include": "#header" },
    { "include": "#number" },
    { "include": "#boolean" },
    { "include": "#null" },
    { "include": "#string" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": { "match": "#.*$", "name": "comment.line.number-sign.aer" },
    "header": { "match": "([A-Za-z_][A-Za-z0-9_.-]*)(\\[[0-9]+\\])?(\\{[^}]+\\})?:", "captures": { "1": { "name": "entity.name.section.aer" }, "2": { "name": "constant.numeric.aer" }, "3": { "name": "support.type.property-name.aer" } } },
    "number": { "match": "\\b-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?\\b", "name": "constant.numeric.aer" },
    "boolean": { "match": "\\b(?:true|false)\\b", "name": "constant.language.aer" },
    "null": { "match": "\\bnull\\b", "name": "constant.language.null.aer" },
    "string": { "match": "\"(?:\\\\.|[^\"\\\\])*\"", "name": "string.quoted.double.aer" },
    "punctuation": { "match": "[\\[\\]{}():,]", "name": "punctuation.aer" }
  }
}
