{
  "name": "aer-language-support",
  "displayName": "AER Language Support",
  "description": "AER format support with validation, formatting and JSON conversion.",
  "version": "0.1.0",
  "publisher": "aer-format",
  "main": "./extension.js",
  "engines": { "vscode": ">=1.90.0" },
  "categories": ["Programming Languages", "Formatters"],
  "activationEvents": ["onLanguage:aer"],
  "contributes": {
    "languages": [{
      "id": "aer",
      "aliases": ["AER", "aer"],
      "extensions": [".aer"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "aer",
      "scopeName": "source.aer",
      "path": "./syntaxes/aer.tmLanguage.json"
    }],
    "commands": [
      { "command": "aer.format", "title": "AER: Format Document" },
      { "command": "aer.validate", "title": "AER: Validate Document" },
      { "command": "aer.toJson", "title": "AER: Convert to JSON" },
      { "command": "aer.toAer", "title": "AER: Convert JSON to AER" },
      { "command": "aer.benchmark", "title": "AER: Show Benchmark" }
    ],
    "configuration": {
      "title": "AER",
      "properties": {
        "aer.cliPath": {
          "type": "string",
          "default": "aer",
          "description": "Path to the AER CLI executable."
        },
        "aer.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Format AER documents on save."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc extension.ts --target ES2022 --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck --outDir ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
